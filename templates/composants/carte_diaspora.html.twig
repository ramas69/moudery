{# La carte de la diaspora (page d'accueil et pages de connexion, 29 septembre 2026) : la France et ses villes, des
   arcs qui portent l'argent jusqu'au village au bord du fleuve Sénégal. Décorative. Styles : carte_diaspora.css.
   Variables : classe (facultative). #}
{% set villes = [
    {nom: 'Lille', x: 378.9, y: 39.9, c: '150 250', d: 0.0},
    {nom: 'Rouen', x: 347.1, y: 57.1, c: '96 262', d: 0.9},
    {nom: 'Paris', x: 367.4, y: 65.6, c: '120 300', d: 0.3},
    {nom: 'Le Mans', x: 332.4, y: 77.9, c: '70 290', d: 1.5},
    {nom: 'Lyon', x: 407.8, y: 110.4, c: '190 330', d: 0.6},
    {nom: 'Bordeaux', x: 319.7, y: 123.8, c: '60 330', d: 1.2},
    {nom: 'Marseille', x: 416.5, y: 146.2, c: '240 360', d: 1.8},
] %}
<figure class="carte-diaspora {{ classe|default('') }}" aria-hidden="true">
    <svg viewBox="0 0 520 620" focusable="false">
        <defs>
            <radialGradient id="halo" cx="50%" cy="50%" r="50%">
                <stop offset="0" stop-color="#f3c77b" stop-opacity="0.9"/>
                <stop offset="0.45" stop-color="#f3c77b" stop-opacity="0.25"/>
                <stop offset="1" stop-color="#f3c77b" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="arc" x1="1" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#7fd1b0" stop-opacity="0.15"/>
                <stop offset="1" stop-color="#f3c77b" stop-opacity="0.9"/>
            </linearGradient>
            <pattern id="points" width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.1" fill="#ffffff" fill-opacity="0.07"/></pattern>
        </defs>
        <rect width="520" height="620" fill="url(#points)"/>
        <path class="carte__terre" d="M367.7 33.8L359.3 35.2L355.2 38.4L351.4 48.1L330.8 56.4L322.6 58.4L308.7 53.8L297.6 53.1L303.1 65.8L296.6 68.6L273.2 66.1L256.1 72.3L252.2 77.4L274.3 81.6L293.4 88.6L300.2 99.8L310.4 104.7L312.4 112.5L310.1 126.4L303.8 143.5L300.4 145.3L309.0 148.2L331.4 152.7L351.9 156.3L375.7 158.3L380.7 158.6L378.5 154.8L381.2 147.9L389.4 144.7L393.1 142.8L404.0 145.4L416.5 146.2L425.6 149.0L437.2 146.6L443.1 142.5L447.4 140.3L451.2 139.2L441.4 130.2L439.0 120.0L440.8 109.5L429.2 104.1L428.4 99.8L443.1 85.2L452.7 83.9L456.1 69.7L463.1 63.9L441.4 60.6L430.0 56.2L423.0 56.0L407.6 47.0L397.5 49.0L394.2 44.9L387.7 43.2L381.2 38.8L370.6 33.2Z"/>
        <path class="carte__terre" d="M60.7 541.3L75.3 537.7L86.7 533.3L98.1 537.7L112.7 546.4L120.9 553.6L129.8 559.4L132.3 565.2L137.2 579.7L130.6 592.0L106.2 594.2L83.5 595.6L57.4 593.5L55.8 584.0L67.2 578.2L81.8 581.1L80.2 576.8L59.1 573.9L45.4 561.4L50.9 558.0L55.8 547.8Z"/>
        <path class="carte__fleuve" d="M60.7 541.6 Q60.7 541.6 68.8 538.0 Q76.9 534.5 81.3 533.5 Q85.7 532.6 92.7 535.9 Q99.7 539.1 106.7 543.0 Q113.6 546.9 120.0 552.5 Q126.4 558.0 134.7 561.2 L143.0 564.5"/>
        <text class="carte__pays" x="352" y="188">France</text>
        <text class="carte__pays" x="54" y="622">Sénégal</text>

        {% for v in villes %}
            <path id="arc-{{ loop.index }}" class="carte__arc" style="--retard: {{ v.d }}s" d="M{{ v.x }} {{ v.y }} Q{{ v.c }} 128.2 557.2"/>
        {% endfor %}
        {% for v in villes %}
            <circle class="carte__piece" r="3.2"><animateMotion dur="{{ 3.2 + loop.index0 * 0.35 }}s" begin="{{ 1.2 + v.d }}s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#arc-{{ loop.index }}"/></animateMotion></circle>
        {% endfor %}
        {% for v in villes %}
            <circle class="carte__ville" cx="{{ v.x }}" cy="{{ v.y }}" r="4"/>
        {% endfor %}
        <text class="carte__nom" x="244" y="46" text-anchor="end">Lille · Rouen · Paris</text>
        <text class="carte__nom" x="244" y="64" text-anchor="end">Le Mans · Lyon</text>
        <text class="carte__nom" x="244" y="82" text-anchor="end">Bordeaux · Marseille</text>

        <circle class="carte__halo" cx="128.2" cy="557.2" r="46" fill="url(#halo)"/>
        <circle class="carte__village" cx="128.2" cy="557.2" r="7"/>
        <text class="carte__village-nom" x="150" y="534">Moudéry</text>
        <text class="carte__village-note" x="150" y="551">{{ 'vitrine.une.fleuve'|trans }}</text>
    </svg>
</figure>
