{# Page d'accueil publique, refaite le 29 septembre 2026 (demande de Rama : « moderne, effet waouh » ; la carte animée
   vers Moudéry a été retirée le soir même à sa demande). Un haut de page typographique sur le vert nuit, puis
   l'application elle-même (écrans en HTML, aucun visuel importé), les rôles, les règles, les étapes, l'appel final.
   Aucune inscription libre : on se connecte, ou l'association nous écrit. #}
{% extends 'base.html.twig' %}
{% import 'composants/icones.html.twig' as icones %}

{% block title %}{{ 'vitrine.titre_page'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/presentation.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/legal.css') }}">
{% endblock %}

{% set contact = 'mailto:' ~ legal.contact ~ '?subject=' ~ ('vitrine.contact_sujet'|trans|url_encode) %}


{% block body %}
    <div class="vitrine">
        <section class="vitrine__une" aria-labelledby="vitrine-titre">
            <header class="vitrine__entete">
                {{ include('composants/marque_claire.html.twig') }}
                <a class="vitrine__connexion" href="{{ path('connexion') }}">{{ 'vitrine.se_connecter'|trans }}</a>
            </header>

            <div class="vitrine__une-grille">
                <div class="vitrine__une-texte">
                    <p class="vitrine__accroche">{{ 'vitrine.une.accroche'|trans }}</p>
                    <h1 id="vitrine-titre" class="vitrine__titre">{{ 'vitrine.une.titre'|trans }}</h1>
                    <p class="vitrine__chapo">{{ 'vitrine.une.chapo'|trans }}</p>
                    <div class="vitrine__actions">
                        <a class="vitrine__bouton vitrine__bouton--plein" href="{{ path('connexion') }}">{{ 'vitrine.se_connecter'|trans }}</a>
                        <a class="vitrine__bouton vitrine__bouton--contour" href="{{ contact }}">{{ 'vitrine.une.association'|trans }}</a>
                    </div>
                </div>

                {# La carte : les villes de France, des arcs qui portent l'argent jusqu'au village. Décorative. #}
            </div>
        </section>

        {# L'application en action (refaite le 29 septembre 2026) : un membre paie sur son téléphone, la pièce file vers le
           tableau de bord, le collecté augmente, la barre du mois grandit, le fil annonce « un membre », jamais un nom.
           Un cycle de 9 s, lancé seulement quand la section est à l'écran (contrôleur Stimulus `vitrine`). Illustration :
           chiffres d'exemple, décorative pour les lecteurs d'écran. #}
        <section class="vitrine__demo" aria-label="{{ 'vitrine.ecrans.aria'|trans }}">
            <div class="demo" data-controller="vitrine" aria-hidden="true">
                <div class="demo__telephone">
                    <div class="demo__encoche"></div>
                    <p class="demo__surtitre">Bonjour Hawa · Lyon</p>
                    <strong class="demo__titre-tel">{{ 'vitrine.ecrans.echeances'|trans }}</strong>
                    <div class="demo__du"><small>{{ 'vitrine.ecrans.a_payer'|trans }}</small><b><span class="demo__du-avant">60 €</span><span class="demo__du-apres">0 €</span></b></div>
                    <ul class="demo__liste">
                        <li><span>{{ 'vitrine.ecrans.cotisation'|trans }}</span><b>10 €</b></li>
                        <li><span>{{ 'vitrine.ecrans.ecole'|trans }}</span><b>50 €</b></li>
                    </ul>
                    <span class="demo__bouton">
                        <span class="demo__bouton-avant">{{ 'vitrine.ecrans.payer'|trans }}</span>
                        <span class="demo__bouton-apres">{{ icones.icone('coche', 16) }}{{ 'vitrine.ecrans.paye'|trans }}</span>
                        <i class="demo__doigt"></i>
                    </span>
                    <p class="demo__note">{{ 'vitrine.ecrans.anonyme'|trans }}</p>
                </div>

                <span class="demo__trajet"><span class="demo__piece"></span></span>

                <div class="demo__tableau">
                    <div class="demo__barre"><span></span><span></span><span></span><em>{{ 'vitrine.ecrans.tableau'|trans }} · Lyon</em></div>
                    <div class="demo__contenu">
                        <div class="demo__kpis">
                            <div class="demo__kpi demo__kpi--vivant"><small>{{ 'vitrine.ecrans.collecte'|trans }}</small><b><span class="demo__kpi-avant">29 410 €</span><span class="demo__kpi-apres">29 470 €</span></b></div>
                            <div class="demo__kpi"><small>{{ 'vitrine.ecrans.depense'|trans }}</small><b>11 730 €</b></div>
                            <div class="demo__kpi"><small>{{ 'vitrine.ecrans.a_jour'|trans }}</small><b>77 %</b></div>
                        </div>
                        <div class="demo__graphique">
                            {% for h in [38, 72, 64, 30, 26, 44, 28, 34, 52, 30, 22] %}<span style="--h: {{ h }}%"></span>{% endfor %}
                            <span class="demo__barre-vivante"></span>
                        </div>
                        <ul class="demo__fil">
                            <li class="demo__fil-nouveau"><i></i><span>{{ 'vitrine.ecrans.fil_nouveau'|trans }}</span><em>{{ 'vitrine.ecrans.a_l_instant'|trans }}</em></li>
                            <li><i></i><span>{{ 'vitrine.ecrans.fil_1'|trans }}</span><em>{{ 'vitrine.ecrans.il_y_a'|trans }}</em></li>
                            <li><i></i><span>{{ 'vitrine.ecrans.fil_2'|trans }}</span><em>{{ 'vitrine.ecrans.hier'|trans }}</em></li>
                        </ul>
                    </div>
                </div>
            </div>
            <p class="vitrine__legende">{{ 'vitrine.ecrans.legende'|trans }}</p>
        </section>

        <main id="contenu">
            <section class="vitrine__section" aria-labelledby="roles-titre">
                <h2 id="roles-titre" class="vitrine__h2">{{ 'vitrine.roles.titre'|trans }}</h2>
                <div class="vitrine__roles">
                    {% for role, icone in {central: 'associations', ville: 'villes', membre: 'comptes'} %}
                        <article class="role">
                            <span class="role__icone" aria-hidden="true">{{ icones.icone(icone, 22) }}</span>
                            <h3>{{ ('vitrine.roles.' ~ role ~ '.nom')|trans }}</h3>
                            <p>{{ ('vitrine.roles.' ~ role ~ '.texte')|trans }}</p>
                        </article>
                    {% endfor %}
                </div>
            </section>

            <section class="vitrine__regles" aria-labelledby="regles-titre">
                <div class="vitrine__section">
                    <h2 id="regles-titre" class="vitrine__h2">{{ 'vitrine.regles.titre'|trans }}</h2>
                    <ul class="regles">
                        {% for regle in ['deux', 'noms', 'etanche', 'trace'] %}
                            <li><strong>{{ ('vitrine.regles.' ~ regle ~ '.titre')|trans }}</strong><span>{{ ('vitrine.regles.' ~ regle ~ '.texte')|trans }}</span></li>
                        {% endfor %}
                    </ul>
                </div>
            </section>

            <section class="vitrine__section" aria-labelledby="etapes-titre">
                <h2 id="etapes-titre" class="vitrine__h2">{{ 'vitrine.etapes.titre'|trans }}</h2>
                <ol class="etapes">
                    {% for etape in ['villes', 'classeurs', 'invitations', 'suivi', 'ag'] %}
                        <li><strong>{{ ('vitrine.etapes.' ~ etape ~ '.titre')|trans }}</strong><span>{{ ('vitrine.etapes.' ~ etape ~ '.texte')|trans }}</span></li>
                    {% endfor %}
                </ol>
            </section>

            <section class="vitrine__final" aria-labelledby="final-titre">
                <h2 id="final-titre">{{ 'vitrine.final.titre'|trans }}</h2>
                <p>{{ 'vitrine.final.texte'|trans }}</p>
                <div class="vitrine__actions">
                    <a class="vitrine__bouton vitrine__bouton--plein" href="{{ contact }}">{{ icones.icone('envoyer', 16) }}{{ 'vitrine.final.ecrire'|trans }}</a>
                    <a class="vitrine__bouton vitrine__bouton--contour" href="{{ path('connexion') }}">{{ 'vitrine.se_connecter'|trans }}</a>
                </div>
                <p class="vitrine__membre"><strong>{{ 'vitrine.membre.titre'|trans }}</strong> {{ 'vitrine.membre.texte'|trans }}</p>
            </section>
        </main>

        <footer class="vitrine__pied">
            {{ include('composants/pied_legal.html.twig') }}
        </footer>
    </div>
{% endblock %}
