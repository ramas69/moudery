# Configuration de production de Caisses sur o2switch, à copier en .env.local À LA RACINE DU PROJET SUR LE SERVEUR.
# Ce fichier-ci ne contient que des exemples : les vrais secrets ne sont jamais dans le code ni dans Git.
APP_ENV=prod
APP_DEBUG=0
# 32 caractères aléatoires : php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
APP_SECRET=a_generer_sur_le_serveur

# Adresse publique du site (liens des e-mails envoyés hors requête : relances, file d'e-mails).
DEFAULT_URI=https://caisses.sansraccourcis.com

# Base créée dans cPanel › Bases de données MySQL (le préfixe du compte cPanel est ajouté aux noms).
# serverVersion : la version affichée par cPanel, par exemple 8.0.36 pour MySQL ou mariadb-10.6.22 pour MariaDB.
DATABASE_URL="mysql://COMPTE_caisses:MOT_DE_PASSE_BASE@localhost:3306/COMPTE_caisses?serverVersion=8.0.36&charset=utf8mb4"

# Boîte d'envoi créée dans cPanel › Comptes de messagerie. L'arobase de l'identifiant s'écrit %40.
MAILER_DSN="smtps://moudery%40sansraccourcis.com:MOT_DE_PASSE_EMAIL@tabebuia.o2switch.net:465"
MAILER_FROM="Caisses Moudery <moudery@sansraccourcis.com>"

# File d'e-mails en base, vidée chaque minute par une tâche planifiée (voir deploiement/README.md).
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Mentions légales.
LEGAL_EDITEUR="Nom ou raison sociale de l'éditeur"
LEGAL_ADRESSE="Adresse postale"
LEGAL_DIRECTEUR="Prénom Nom"
LEGAL_CONTACT="moudery@sansraccourcis.com"
